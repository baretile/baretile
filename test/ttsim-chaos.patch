+// queues a Tensix tile's request to run later. returns false if it should run now
+template<char tile_type>
+static bool chaos_defer(uint32_t tile_id, uint32_t noc_instance, uint32_t cmd_buf) {
+    if (tile_type != 'T' || !s_chaos.noc || s_chaos.replaying) return false;
+    ChaosRequest r = {s_chaos.seq++, g_current_chip_id, tile_id, noc_instance, cmd_buf, {}};
+    for (uint32_t i = 0; i < 10; i++) r.regs[i] = *chaos_reg<tile_type>(tile_id, noc_instance, cmd_buf, i);
+    uint32_t ctrl = r.regs[7], txn_id = bits<13,10>(r.regs[6]);
+    bool write, counted;
+    chaos_kind(ctrl, &write, &counted);
+    if (counted) get_tile<tile_type>(tile_id)->niu_mst_reqs_outstanding[noc_instance][txn_id]++;
+    if (write) s_chaos.outgoing[{r.chip_id, tile_id, noc_instance, txn_id}]++;
+    uint64_t due = g_clock + s_chaos.noc_lo + chaos_rand() % (s_chaos.noc_hi - s_chaos.noc_lo + 1);
+    if (bits<7,7>(ctrl)) { // on a static VC, it can't pass anything sent earlier on the same route
+        uint64_t &last = s_chaos.last_due[{r.chip_id, tile_id, noc_instance, r.regs[2], r.regs[5], bits<15,14>(ctrl)}];
+        due = std::max(due, last);
+        last = due;
+    }
+    s_chaos.pending.emplace(std::make_pair(due, r.seq), r);
+    return true;
+}
