+// ---- ttsim-chaos: Tensix units that take time, off unless TTSIM_CHAOS_MATH is set (see baretile's docs/testing.md) ----
+// ttsim runs each instruction when it reaches the head of its thread, and its STALLWAIT and SEMWAIT block the whole
+// thread. With TTSIM_CHAOS_MATH=lo,hi, a thread's instructions pass a wait gate as in the ISA's STALLWAIT.md instead. A
+// STALLWAIT or SEMWAIT latches there, and blocks only the instructions its block mask names until its conditions are
+// met. An FPU or SFPU instruction that passes the gate runs lo to hi clocks later, and reads Dst and the configuration
+// as they are then. FPU and SFPU instructions run in the order they passed the gate, with the address modes they saw
+// there, since tt-llk relies on their RWCs updating in that order: it moves the Dst counter with SETRWC between SFPU
+// instructions, and rewrites address modes with SETC16, without waiting. The other units still run an instruction when
+// it passes the gate. So a config write or SEMPOST that should wait for the FPU or SFPU, or a packer that a semaphore
+// lets in too early, sees that work unfinished unless a STALLWAIT holds it back.
+
+// The block mask bits that hold back each opcode, from the table in the Blackhole ISA's STALLWAIT.md. 0x040 is the
+// FPU and 0x100 the SFPU. Opcodes the table leaves out are held by any bit.
+static const uint16_t CHAOS_BLOCKED_BY[256] = {
+    0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x040, 0x040, 0x040, 0x040, 0x1FF, 0x1FF, 0x1FF, 0x1FF,
+    0x040, 0x040, 0x040, 0x040, 0x1FF, 0x1FF, 0x040, 0x040, 0x040, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF,
+    0x1FF, 0x040, 0x040, 0x040, 0x040, 0x040, 0x040, 0x040, 0x040, 0x040, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF,
+    0x040, 0x040, 0x040, 0x040, 0x040, 0x040, 0x040, 0x040, 0x040, 0x1FF, 0x040, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF,
+    0x011, 0x005, 0x009, 0x009, 0x001, 0x021, 0x021, 0x1FF, 0x021, 0x021, 0x005, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF,
+    0x001, 0x001, 0x001, 0x001, 0x001, 0x001, 0x001, 0x001, 0x021, 0x021, 0x021, 0x021, 0x021, 0x021, 0x001, 0x1FF,
+    0x021, 0x021, 0x021, 0x021, 0x021, 0x1FF, 0x021, 0x021, 0x021, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF,
+    0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100,
+    0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100,
+    0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF,
+    0x002, 0x002, 0x1FF, 0x002, 0x002, 0x002, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF,
+    0x080, 0x080, 0x080, 0x080, 0x080, 0x080, 0x080, 0x080, 0x080, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF,
+    0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF,
+    0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF,
+    0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF,
+    0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF
+};
+enum { CHAOS_FPU = 0x040, CHAOS_SFPU = 0x100 };
+// The thread config registers that ApplyAddrMod reads (ISA RWCs.md): ADDR_MOD_AB_SEC0-7, ADDR_MOD_DST_SEC0-7 and
+// ADDR_MOD_BIAS_SEC0-7 in cfg_defines.h
+static const uint8_t CHAOS_ADDR_MOD_REGS[CHAOS_ADDR_MODS] = {12, 13, 14, 15, 16, 17, 18, 19, 28, 29, 30, 31, 32, 33, 34, 35,
+                                                              47, 48, 49, 50, 51, 52, 53, 54};
+static uint16_t *chaos_thread_cfg(TensixState *p_tensix, uint32_t pipe, uint32_t reg) {
+    switch (reg) {
+#define THREAD_CFG_REG_AT(i) case i: return &p_tensix->thread[pipe].thread_cfg##i;
+        FOR_EACH_THREAD_CFG_REG(THREAD_CFG_REG_AT)
+#undef THREAD_CFG_REG_AT
+    }
+    TTSIM_ERROR(AssertionFailure, "ttsim-chaos: no thread config register %u", reg);
+}
+// swaps the thread's address modes with the ones in modes
+static void chaos_swap_addr_mods(TensixState *p_tensix, uint32_t pipe, uint16_t *modes) {
+    for (uint32_t i = 0; i < CHAOS_ADDR_MODS; i++) std::swap(*chaos_thread_cfg(p_tensix, pipe, CHAOS_ADDR_MOD_REGS[i]), modes[i]);
+}
+
+// Whether the thread's latched wait must still hold. STALLWAIT conditions C4 and C11 wait for this thread's FPU and
+// SFPU instructions; C5, C7 and C8 for SrcA and SrcB as ttsim's STALLWAIT does. The rest are met at once, since
+// ttsim's other units take no time.
+static bool chaos_waiting(const TensixState *p_tensix, uint32_t pipe) {
+    const ChaosWait &w = p_tensix->chaos_wait[pipe];
+    if (w.sem) {
+        uint32_t i = __builtin_ctz(w.sem_sel);
+        return ((w.conditions & 1) && !p_tensix->sem[i]) || ((w.conditions & 2) && p_tensix->sem[i] >= p_tensix->sem_max[i]);
+    }
+    uint32_t c = w.conditions;
+    return ((c & 0x10) && p_tensix->chaos_math_thread[0][pipe]) || ((c & 0x800) && p_tensix->chaos_math_thread[1][pipe])
+        || ((c & 0x20) && (p_tensix->src_a_valid & (1 << p_tensix->src_a_unpack_bank)))
+        || ((c & 0x80) && !(p_tensix->src_a_valid & (1 << p_tensix->src_a_matrix_bank)))
+        || ((c & 0x100) && !(p_tensix->src_b_valid & (1 << p_tensix->src_b_matrix_bank)));
+}
+
+// Passes the instruction at the head of a thread through its wait gate. Returns false if it must wait there.
+bool chaos_tensix_issue(TensixState *p_tensix, uint32_t pipe, uint32_t inst) {
+    if (!chaos_math_on()) return tensix_decode_and_execute(p_tensix, pipe, inst);
+    uint32_t opcode = bits<31,24>(inst), blocked_by = CHAOS_BLOCKED_BY[opcode];
+    ChaosWait &w = p_tensix->chaos_wait[pipe];
+    if (w.block && !chaos_waiting(p_tensix, pipe)) w.block = 0; // its conditions are met, so it's forgotten
+    if (w.block & blocked_by) return false;
+    if (opcode == TENSIX_OPCODE_STALLWAIT) {
+        uint32_t wait_res = bits<12,0>(inst), stall_res = bits<23,15>(inst);
+        TTSIM_VERIFY(!(wait_res & ~0x1DBF), UnimplementedFunctionality, "ttsim-chaos: STALLWAIT wait_res=0x%x", wait_res);
+        w = {stall_res ? stall_res : 1u << 6, wait_res ? wait_res : 0xFu, 0, false};
+        return true;
+    }
+    if (opcode == TENSIX_OPCODE_SEMWAIT) {
+        uint32_t cond = bits<1,0>(inst), sem_sel = bits<9,2>(inst), stall_res = bits<23,15>(inst);
+        TTSIM_VERIFY(__builtin_popcount(sem_sel) == 1, UnsupportedFunctionality, "sem_sel=0x%x is not one-hot", sem_sel);
+        TTSIM_VERIFY(cond, UndefinedBehavior, "wait_sem_cond=%d", cond);
+        w = {stall_res ? stall_res : 1u << 6, cond, sem_sel, true};
+        return true;
+    }
+    if (blocked_by != CHAOS_FPU && blocked_by != CHAOS_SFPU) return tensix_decode_and_execute(p_tensix, pipe, inst);
+    uint32_t sfpu = blocked_by == CHAOS_SFPU;
+    if (p_tensix->chaos_math_n == CHAOS_MATH_DEPTH) return false; // full, so the thread waits
+    ChaosMathInst &m = p_tensix->chaos_math[(p_tensix->chaos_math_rd + p_tensix->chaos_math_n++) % CHAOS_MATH_DEPTH];
+    m = {chaos_math_due(), inst, pipe, sfpu, {}};
+    for (uint32_t i = 0; i < CHAOS_ADDR_MODS; i++) m.addr_mods[i] = *chaos_thread_cfg(p_tensix, pipe, CHAOS_ADDR_MOD_REGS[i]);
+    p_tensix->chaos_math_thread[sfpu][pipe]++;
+    return true;
+}
+
+// Runs the FPU and SFPU instructions that are due, in order. Returns whether any ran.
+bool chaos_tensix_math(TensixState *p_tensix) {
+    bool ran = false;
+    while (p_tensix->chaos_math_n) {
+        ChaosMathInst &head = p_tensix->chaos_math[p_tensix->chaos_math_rd];
+        if (head.due > g_clock) break;
+        chaos_swap_addr_mods(p_tensix, head.pipe, head.addr_mods); // its address modes in, and the thread's out
+        bool done = tensix_decode_and_execute(p_tensix, head.pipe, head.inst);
+        chaos_swap_addr_mods(p_tensix, head.pipe, head.addr_mods); // and back
+        if (!done) break;
+        p_tensix->chaos_math_thread[head.sfpu][head.pipe]--;
+        p_tensix->chaos_math_rd = (p_tensix->chaos_math_rd + 1) % CHAOS_MATH_DEPTH;
+        p_tensix->chaos_math_n--;
+        ran = true;
+    }
+    return ran;
+}
