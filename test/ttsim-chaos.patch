+// ttsim-chaos: runs a request that's due with its registers as they were at issue, then restores them and undoes the
+// counts that chaos_defer added. noc_cmd_ctrl also counts a multicast's request, which would otherwise count twice.
+template<char tile_type>
+static void chaos_replay(const ChaosRequest &r) {
+    uint32_t saved[10];
+    for (uint32_t i = 0; i < 10; i++) {
+        uint32_t *reg = chaos_reg<tile_type>(r.tile_id, r.noc_instance, r.cmd_buf, i);
+        saved[i] = *reg;
+        *reg = r.regs[i];
+    }
+    s_chaos.replaying = true;
+    noc_cmd_ctrl<tile_type>(r.tile_id, r.noc_instance, r.cmd_buf);
+    s_chaos.replaying = false;
+    for (uint32_t i = 0; i < 10; i++) *chaos_reg<tile_type>(r.tile_id, r.noc_instance, r.cmd_buf, i) = saved[i];
+    uint32_t txn_id = bits<13,10>(r.regs[6]);
+    bool write, counted;
+    chaos_kind(r.regs[7], &write, &counted);
+    if (counted) get_tile<tile_type>(r.tile_id)->niu_mst_reqs_outstanding[r.noc_instance][txn_id]--;
+    if (write) s_chaos.outgoing[{r.chip_id, r.tile_id, r.noc_instance, txn_id}]--;
+}
+
+void chaos_tick() {
+    while (!s_chaos.pending.empty() && s_chaos.pending.begin()->first.first <= g_clock) {
+        ChaosRequest r = s_chaos.pending.begin()->second;
+        s_chaos.pending.erase(s_chaos.pending.begin());
+        uint32_t saved_chip_id = g_current_chip_id;
+        ttsim_select_chip(r.chip_id);
+        chaos_replay<'T'>(r);
+        ttsim_select_chip(saved_chip_id);
     }
 }
 
