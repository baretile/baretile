+template<char tile_type>
+static uint32_t *chaos_reg(uint32_t tile_id, uint32_t n, uint32_t b, uint32_t i) {
+    auto *p_tile = get_tile<tile_type>(tile_id);
+    uint32_t *regs[] = {&p_tile->noc_targ_addr_lo[n][b], &p_tile->noc_targ_addr_mid[n][b], &p_tile->noc_targ_addr_hi[n][b],
+                        &p_tile->noc_ret_addr_lo[n][b], &p_tile->noc_ret_addr_mid[n][b], &p_tile->noc_ret_addr_hi[n][b],
+                        &p_tile->noc_packet_tag[n][b], &p_tile->noc_ctrl[n][b], &p_tile->noc_at_len_be[n][b], &p_tile->noc_at_data[n][b]};
