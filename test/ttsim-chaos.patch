+// Decodes NOC_CTRL the way noc_cmd_ctrl does: is it a write, and is it counted? Reads are counted, and writes are
+// counted when acknowledged. Atomics aren't, since neither counter tracks them here.
+static void chaos_kind(uint32_t ctrl, bool *write, bool *counted) {
+    bool multicast = bits<5,5>(ctrl), atomic = !multicast && bits<0,0>(ctrl);
+    *write = multicast || (!atomic && (bits<3,3>(ctrl) || bits<1,1>(ctrl)));
+    *counted = !atomic && (!*write || bits<4,4>(ctrl));
+}
